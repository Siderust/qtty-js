{
  "name": "@siderust/qtty",
  "version": "0.1.0",
  "description": "Strongly-typed physical quantities and unit conversions for Node.js, powered by Rust",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./units": {
      "require": "./units.js",
      "import": "./units.js",
      "types": "./units.d.ts"
    }
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test __test__/*.test.mjs",
    "test:coverage": "c8 --config c8.config.json node --test __test__/*.test.mjs",
    "ci": "npm run format:check && npm run lint && npm run build:debug && npm test && npm run test:coverage",
    "prepublishOnly": "napi build --release --platform"
  },
  "napi": {
    "name": "qtty",
    "triples": {
      "defaults": true
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.cjs",
    "lib/",
    "units.js",
    "units.d.ts",
    "examples/",
    "README.md"
  ],
  "keywords": [
    "quantities",
    "units",
    "conversion",
    "physics",
    "science",
    "astronomy",
    "napi",
    "rust",
    "native"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Siderust/qtty"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.5.1",
    "c8": "^11.0.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "prettier": "^3.6.2"
  }
}
