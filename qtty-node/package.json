{
  "name": "@siderust/qtty",
  "version": "0.4.0",
  "description": "Strongly-typed physical quantities and unit conversions for Node.js, powered by Rust",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./units": {
      "require": "./units.js",
      "import": "./units.js",
      "types": "./units.d.ts"
    }
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "test": "node --test __test__/*.test.mjs",
    "prepublishOnly": "napi build --release --platform"
  },
  "napi": {
    "name": "qtty",
    "triples": {
      "defaults": true
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "units.js",
    "units.d.ts",
    "examples/",
    "README.md"
  ],
  "keywords": [
    "quantities",
    "units",
    "conversion",
    "physics",
    "science",
    "astronomy",
    "napi",
    "rust",
    "native"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Siderust/qtty"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
